<Configuration status="off"> <!-- log4j2 自体のロガーはオフ -->
  <!-- Appender や Logger で使用する Property の定義 -->
  <Properties>
    <!-- 一行にまとめて出力するレイアウト -->
    <Property name="oneLine">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %c{1} - %msg%n</Property>
  </Properties>

  <!-- 出力先の定義 -->
  <Appenders>
    <Console name="stdout" target="SYSTEM_OUT">
      <PatternLayout pattern="${oneLine}"/>
    </Console>
  </Appenders>

  <!-- ロガーの定義 -->
  <Loggers>
    <Root level="debug">
      <AppenderRef ref="stdout"/>
    </Root>
  </Loggers>
</Configuration>